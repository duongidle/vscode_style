  "editor.semanticTokenColorCustomizations": {
    "[Light Modern]": {
      "enabled": true,
      "rules": {
        "function": "#3d6a99",
        "method": "#3d6a99",
        "function.defaultLibrary": "#3d6a99",
        "method.defaultLibrary": "#3d6a99",
        "variable": "#2b2a26",
        "variable.readonly": "#2b2a26",
        "variable.defaultLibrary": "#2b2a26",
        "parameter": "#7a5c3e",
        "property": "#8a5a7e",
        "class": "#2f7f7a",
        "interface": "#2f7f7a",
        "type": "#2f7f7a",
        "enum": "#2f7f7a",
        "namespace": "#2f7f7a",
        "typeParameter": "#2f7f7a",
        "enumMember": "#a0701c"
      }
    }
  },
  "editor.tokenColorCustomizations": {
    "[Light Modern]": {
      "textMateRules": [
        {
          "scope": [
            "markup.heading",
            "entity.name.section.markdown",
            "punctuation.definition.heading.markdown",
            "markup.heading.setext"
          ],
          "settings": {
            "foreground": "#a8452a",
            "fontStyle": "bold"
          }
        },
        {
          "scope": [
            "markup.bold",
            "punctuation.definition.bold.markdown"
          ],
          "settings": {
            "foreground": "#2b2a26",
            "fontStyle": "bold"
          }
        },
        {
          "scope": [
            "markup.italic"
          ],
          "settings": {
            "foreground": "#2b2a26",
            "fontStyle": "italic"
          }
        },
        {
          "scope": [
            "markup.underline.link",
            "string.other.link.title.markdown",
            "string.other.link.description.markdown"
          ],
          "settings": {
            "foreground": "#3d6a99"
          }
        },
        {
          "scope": [
            "punctuation.definition.list.begin.markdown",
            "punctuation.definition.table.markdown",
            "meta.separator.markdown",
            "punctuation.separator.table.markdown"
          ],
          "settings": {
            "foreground": "#b0a590"
          }
        },
        {
          "scope": [
            "comment",
            "punctuation.definition.comment"
          ],
          "settings": {
            "foreground": "#9a9186",
            "fontStyle": "italic"
          }
        },
        {
          "scope": [
            "keyword",
            "keyword.control",
            "storage",
            "storage.type",
            "storage.modifier"
          ],
          "settings": {
            "foreground": "#b4492f"
          }
        },
        {
          "scope": [
            "keyword.operator",
            "punctuation"
          ],
          "settings": {
            "foreground": "#7d766a"
          }
        },
        {
          "scope": [
            "string",
            "string.quoted",
            "punctuation.definition.string"
          ],
          "settings": {
            "foreground": "#5c7a4a"
          }
        },
        {
          "scope": [
            "constant.character.escape"
          ],
          "settings": {
            "foreground": "#a77b1e"
          }
        },
        {
          "scope": [
            "constant.numeric",
            "constant.language"
          ],
          "settings": {
            "foreground": "#a0701c"
          }
        },
        {
          "scope": [
            "entity.name.function",
            "support.function",
            "variable.function"
          ],
          "settings": {
            "foreground": "#3d6a99"
          }
        },
        {
          "scope": [
            "entity.name.type",
            "entity.name.class",
            "support.type",
            "support.class",
            "entity.other.inherited-class"
          ],
          "settings": {
            "foreground": "#2f7f7a"
          }
        },
        {
          "scope": [
            "variable.parameter"
          ],
          "settings": {
            "foreground": "#7a5c3e"
          }
        },
        {
          "scope": [
            "variable",
            "variable.other.readwrite"
          ],
          "settings": {
            "foreground": "#2b2a26"
          }
        },
        {
          "scope": [
            "variable.other.property",
            "meta.object-literal.key",
            "support.type.property-name",
            "variable.other.object.property"
          ],
          "settings": {
            "foreground": "#8a5a7e"
          }
        },
        {
          "scope": [
            "entity.name.tag",
            "punctuation.definition.tag"
          ],
          "settings": {
            "foreground": "#b4492f"
          }
        },
        {
          "scope": [
            "entity.other.attribute-name"
          ],
          "settings": {
            "foreground": "#a0701c"
          }
        },
        {
          "scope": [
            "string.regexp"
          ],
          "settings": {
            "foreground": "#9a6a8f"
          }
        },
        {
          "scope": [
            "meta.decorator",
            "entity.name.function.decorator",
            "punctuation.decorator"
          ],
          "settings": {
            "foreground": "#9a6a8f"
          }
        },
        {
          "scope": [
            "invalid",
            "invalid.illegal"
          ],
          "settings": {
            "foreground": "#c9302c"
          }
        }
      ]
    }
  },
  "workbench.tree.indent": 10,
  "workbench.tree.renderIndentGuides": "none",
  "editor.fontWeight": "400",
  "editor.fontSize": 12.5,
  "editor.lineHeight": 22,
  "[markdown]": {
    "editor.wordWrap": "bounded",
    "editor.wordWrapColumn": 100,
    "editor.fontSize": 13.5,
    "editor.lineHeight": 1.75,
    "editor.padding.top": 12,
    "editor.padding.bottom": 12
  },
  "editor.minimap.enabled": false,
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.navigationControl.enabled": false,
  "workbench.layoutControl.enabled": false,
  "explorer.compactFolders": false,
  "vscode_custom_css.imports": [
    "file://${userHome}/.vscode-custom/float-clay.css",
    "file://${userHome}/.vscode-custom/float-clay-menu.js"
  ],
  "window.menuStyle": "custom",
  "window.dialogStyle": "custom"
}
